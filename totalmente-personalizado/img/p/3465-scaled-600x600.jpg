<script></script><style id="tp-file-es-css">
.tp-archivo{display:flex!important;align-items:center;gap:12px;flex-wrap:wrap;margin:6px 0 4px;cursor:pointer;position:relative}
.tp-archivo input[type=file]{position:absolute!important;width:1px!important;height:1px!important;opacity:0!important;overflow:hidden!important;padding:0!important;border:0!important}
.tp-archivo .tp-arch-btn{display:inline-block;padding:9px 16px;border-radius:8px;background:#603186;color:#fff;font-weight:700;font-size:14px;line-height:1.2}
.tp-archivo .tp-arch-nom{font-size:13px;color:#5b4a6b;word-break:break-all}
.tp-archivo:focus-within .tp-arch-btn{outline:2px solid #c5872a;outline-offset:2px}
</style>
<script id="tp-file-es-js">
(function(){
  var VACIO='Ningún archivo seleccionado';
  function pinta(i){
    var n=i.parentNode.querySelector('.tp-arch-nom');
    if(n) n.textContent=i.files&&i.files.length?Array.prototype.map.call(i.files,function(f){return f.name}).join(', '):VACIO;
  }
  function envuelve(i){
    if(i.closest('.archivo,.tp-archivo')) return;
    var l=document.createElement('label'); l.className='tp-archivo';
    i.parentNode.insertBefore(l,i); l.appendChild(i);
    var b=document.createElement('span'); b.className='tp-arch-btn'; b.textContent=i.multiple?'Elegir archivos':'Elegir archivo';
    var n=document.createElement('span'); n.className='tp-arch-nom'; n.textContent=VACIO;
    l.appendChild(b); l.appendChild(n);
    i.addEventListener('change',function(){pinta(i)});
    if(i.form) i.form.addEventListener('reset',function(){setTimeout(function(){pinta(i)},0)});
  }
  function todo(){document.querySelectorAll('input[type=file]').forEach(envuelve)}
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',todo); else todo();
  document.addEventListener('wpcf7mailsent',function(){setTimeout(function(){document.querySelectorAll('.tp-archivo input[type=file]').forEach(pinta)},50)});
})();
</script>
        <script id="tp-i18n-ux-hotfix">
    (function(){
      function swap(root){
        if(!root) root=document;
        var it = document.createNodeIterator(root, NodeFilter.SHOW_TEXT);
        var n;
        while((n=it.nextNode())){
          if(!n.nodeValue) continue;
          n.nodeValue = n.nodeValue
            .replace(/\bShopping cart\b/g,'Carrito')
            .replace(/\bClose\b/g,'Cerrar');
        }
        var inputs = root.querySelectorAll ? root.querySelectorAll('input[placeholder],input[aria-label],textarea[placeholder],textarea[aria-label]') : [];
        inputs.forEach(function(el){
          ['placeholder','aria-label'].forEach(function(a){
            var v=el.getAttribute(a);
            if(v==='Search for products') el.setAttribute(a,'Buscar productos');
            if(v==='Close') el.setAttribute(a,'Cerrar');
          });
        });
      }
      swap(document);
      var mo = new MutationObserver(function(ms){ ms.forEach(function(m){ m.addedNodes && m.addedNodes.forEach(function(node){ if(node && node.nodeType===1) swap(node); }); }); });
      mo.observe(document.documentElement,{childList:true,subtree:true});
    })();
    </script>
        <div class="tp-account-shortcut" aria-label="Acceso rápido a Mi cuenta">
        <a href="https://totalmentepersonalizado.com/mi-cuenta/">Mi cuenta / Acceder</a>
    </div>
    <style id="tp-account-shortcut-css">
        .tp-account-shortcut{position:fixed;right:16px;bottom:16px;z-index:9998}
        .tp-account-shortcut a{display:inline-flex;align-items:center;gap:8px;padding:11px 14px;border-radius:999px;background:#111;color:#fff;font-size:14px;font-weight:600;line-height:1;text-decoration:none;box-shadow:0 10px 30px rgba(0,0,0,.18)}
        .tp-account-shortcut a:hover{background:#000;color:#fff}
        @media (max-width: 767px){.tp-account-shortcut{right:12px;bottom:12px}.tp-account-shortcut a{padding:10px 12px;font-size:13px}}
    </style>
    <script id="tp_front_texts_es">
    (function(){
      var replacements = {
        "Search": "Buscar",
        "Login": "Acceder",
        "Log in": "Acceder",
        "LOG IN": "INICIAR SESIÓN",
        "Register": "Registro",
        "Or": "o",
        "Remember me": "Recuérdame",
        "Lost your password?": "¿Has olvidado tu contraseña?",
        "Username or email address": "Nombre de usuario o correo electrónico",
        "Password": "Contraseña",
        "Registering for this site allows you to access your order status and history. Just fill in the fields below, and we'll get a new account set up for you in no time. We will only ask you for information necessary to make the purchase process faster and easier.": "Al registrarte en esta web podrás consultar el estado y el historial de tus pedidos. Solo tienes que completar los campos siguientes y te crearemos una cuenta enseguida. Únicamente te pediremos la información necesaria para que el proceso de compra sea más rápido y sencillo."
      };
      function swapTextNode(node){
        if(!node || !node.nodeValue) return;
        var t = node.nodeValue.trim();
        if(replacements[t]) node.nodeValue = node.nodeValue.replace(t, replacements[t]);
      }
      function patch(root){
        root = root || document;
        document.querySelectorAll("input[placeholder],input[aria-label]").forEach(function(el){
          if(el.placeholder==="Search for products" || el.placeholder==="Search products…" || el.placeholder==="Search products...") el.placeholder="Buscar productos";
          if(el.getAttribute("aria-label")==="Search") el.setAttribute("aria-label","Buscar");
          if(el.getAttribute("placeholder")==="Username or email address") el.setAttribute("placeholder","Nombre de usuario o correo electrónico");
          if(el.getAttribute("placeholder")==="Password") el.setAttribute("placeholder","Contraseña");
        });
        document.querySelectorAll("a[title],button[title]").forEach(function(el){
          if(el.getAttribute("title")==="Search") el.setAttribute("title","Buscar");
        });
        document.querySelectorAll(".registration-info").forEach(function(el){
          var txt = el.textContent.trim();
          if(replacements[txt]) el.textContent = replacements[txt];
        });
        document.querySelectorAll(".woocommerce-form-login__submit,.wd-switch-to-register,[data-login],[data-login-title],[data-register],[data-reg-title]").forEach(function(el){
          ["data-login","data-login-title","data-register","data-reg-title","value"].forEach(function(a){
            var v = el.getAttribute && el.getAttribute(a);
            if(v && replacements[v]) el.setAttribute(a, replacements[v]);
          });
          if(el.textContent){
            var t = el.textContent.trim();
            if(replacements[t]) el.textContent = replacements[t];
          }
        });
        var walker = document.createNodeIterator(root, NodeFilter.SHOW_TEXT);
        var n;
        while((n = walker.nextNode())) swapTextNode(n);
      }
      patch(document);
      document.addEventListener("DOMContentLoaded", function(){ patch(document); });
      var mo = new MutationObserver(function(ms){ ms.forEach(function(m){ m.addedNodes && m.addedNodes.forEach(function(node){ if(node && node.nodeType===1) patch(node); }); }); });
      mo.observe(document.documentElement, {childList:true,subtree:true});
      setTimeout(function(){ patch(document); }, 500);
      setTimeout(function(){ patch(document); }, 1500);
    })();
    </script>
            <style id="tp-cookie-consent-style">
    #tp-cookie-consent{position:fixed;left:0;right:0;bottom:0;background:#2d1538;color:#fffdf9;padding:14px 22px;z-index:99999;font-family:Montserrat,system-ui,-apple-system,sans-serif;font-size:13.5px;line-height:1.45;border-top:3px solid #c5872a;box-shadow:0 -4px 18px rgba(45,21,56,.35)}
    #tp-cookie-consent .tp-cc-inner{max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;gap:12px 18px;align-items:center;justify-content:space-between}
    #tp-cookie-consent p{margin:0;flex:1 1 360px}
    #tp-cookie-consent a{color:#e6b05c;text-decoration:underline}
    #tp-cookie-consent .tp-cc-btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
    #tp-cookie-consent button{cursor:pointer;border:2px solid #c5872a;border-radius:6px;padding:9px 20px;font-weight:700;font-size:13px;font-family:inherit;min-width:110px}
    #tp-cookie-consent .tp-cc-accept{background:#c5872a;color:#2d1538}
    #tp-cookie-consent .tp-cc-refuse{background:#603186;color:#fffdf9}
    #tp-cookie-consent .tp-cc-info{background:transparent;padding:9px 6px}
    </style>
    <div id="tp-cookie-consent" role="dialog" aria-label="Aviso de cookies">
      <div class="tp-cc-inner">
        <p>Usamos cookies propias, necesarias para la tienda, y de terceros para medir la audiencia (Google Analytics). Las de medición solo se activan si aceptas. Puedes cambiar tu decisión cuando quieras desde «Configurar cookies», al pie de la página.</p>
        <div class="tp-cc-btns">
          <button class="tp-cc-accept" type="button">Aceptar</button>
          <button class="tp-cc-refuse" type="button">Rechazar</button>
          <a class="tp-cc-info" href="/politica-de-cookies/" target="_blank" rel="noopener">Más información</a>
        </div>
      </div>
    </div>
        <script>
    (function(){
      function setConsentCookie(val){
        var d=new Date(); d.setTime(d.getTime()+365*24*60*60*1000);
        document.cookie='tp_cookie_consent='+val+';expires='+d.toUTCString()+';path=/;SameSite=Lax';
      }
      function updateGtagConsent(granted){
        if (typeof gtag !== 'function') return;
        var state = granted ? 'granted' : 'denied';
        gtag('consent', 'update', {
          'ad_storage': state,
          'analytics_storage': state,
          'ad_user_data': state,
          'ad_personalization': state
        });
      }
      // Si user ya respondió en cookie, actualizar gtag al cargar
      var existing = document.cookie.match(/(?:^|;\s*)tp_cookie_consent=(true|false)/);
      if (existing) {
        updateGtagConsent(existing[1] === 'true');
      }
      // «Configurar cookies»: cualquier enlace a #configurar-cookies borra la decisión y vuelve a mostrar el aviso
      document.addEventListener('click', function(e){
        var a = e.target.closest ? e.target.closest('a[href$="#configurar-cookies"]') : null;
        if (!a) return;
        e.preventDefault();
        document.cookie='tp_cookie_consent=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;SameSite=Lax';
        updateGtagConsent(false);
        location.reload();
      });
      var bar = document.getElementById('tp-cookie-consent');
      if (bar) {
        bar.querySelector('.tp-cc-accept').onclick=function(){
          setConsentCookie('true');
          updateGtagConsent(true);
          bar.style.display='none';
        };
        bar.querySelector('.tp-cc-refuse').onclick=function(){
          setConsentCookie('false');
          updateGtagConsent(false);
          bar.style.display='none';
        };
      }
    })();
    </script>
    <script>
(function(){
  function decorateQty(scope){
    (scope||document).querySelectorAll('.quantity').forEach(function(q){
      if(q.classList.contains('tp-qty')) return;
      var input=q.querySelector('input.qty');
      if(!input) return;
      q.classList.add('tp-qty');
      var minus=document.createElement('button');
      minus.type='button'; minus.className='tp-qbtn tp-minus'; minus.textContent='−';
      var plus=document.createElement('button');
      plus.type='button'; plus.className='tp-qbtn tp-plus'; plus.textContent='+';
      q.insertBefore(minus,input);
      q.appendChild(plus);
      function step(dir){
        var step=parseFloat(input.step||1)||1;
        var min=parseFloat(input.min||0);
        var max=parseFloat(input.max||999999);
        var val=parseFloat(input.value||0)||0;
        val = dir>0 ? (val+step) : (val-step);
        if(val<min) val=min;
        if(val>max) val=max;
        input.value = (Math.round(val*1000)/1000);
        input.dispatchEvent(new Event('change',{bubbles:true}));
      }
      minus.addEventListener('click',function(){step(-1)});
      plus.addEventListener('click',function(){step(1)});
    });
  }
  decorateQty(document);
  var mo=new MutationObserver(function(m){decorateQty(document)});
  mo.observe(document.body,{childList:true,subtree:true});
})();
</script>
